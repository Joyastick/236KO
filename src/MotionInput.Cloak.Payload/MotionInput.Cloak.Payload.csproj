<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Injected into the target game process (via CloakBootstrap.dll hosting the CLR — see
    ../../native/CloakBootstrap) to hook XInputGetState/XInputGetStateEx and hide one XInput
    user index from that process only. Must stay a normal framework-dependent assembly (not
    NativeAOT) because Reloaded.Hooks relies on Reflection.Emit, which needs a real JIT.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Library projects don't emit a runtimeconfig.json by default; CloakBootstrap.dll (the native
         host) needs one to call hostfxr_initialize_for_runtime_config. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- Copy every dependency DLL into the output folder rather than relying on .deps.json-driven
         NuGet-cache resolution — simpler and more robust once this is loaded via hostfxr inside an
         injected target process. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Reloaded.Hooks" Version="4.3.3" />
  </ItemGroup>

</Project>
