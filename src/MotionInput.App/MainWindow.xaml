<Window x:Class="MotionInput.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MotionInput.App"
        mc:Ignorable="d"
        Title="236KO — Motion Input" Height="760" Width="1150"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Background="#FF202020">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Controller:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                <ComboBox x:Name="ControllerCombo" Width="240" DisplayMemberPath="DisplayName"/>
                <Button x:Name="RefreshControllersButton" Content="Refresh" Margin="6,0,0,0" Padding="8,2" Click="RefreshControllersButton_Click"/>

                <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="20,0,6,0" Foreground="White"/>
                <ComboBox x:Name="ProfileCombo" Width="160" IsEditable="True" SelectionChanged="ProfileCombo_SelectionChanged"/>
                <Button x:Name="NewProfileButton" Content="New" Margin="6,0,0,0" Padding="8,2" Click="NewProfileButton_Click"/>
                <Button x:Name="SaveProfileButton" Content="Save" Margin="4,0,0,0" Padding="8,2" Click="SaveProfileButton_Click"/>
                <Button x:Name="DeleteProfileButton" Content="Delete" Margin="4,0,0,0" Padding="8,2" Click="DeleteProfileButton_Click"/>

                <Button x:Name="StartStopButton" Content="Start" Margin="24,0,0,0" Padding="16,2" Click="StartStopButton_Click"/>
                <Ellipse x:Name="EngineStatusDot" Width="12" Height="12" Fill="Gray" Margin="12,0,4,0"/>
                <TextBlock x:Name="EngineStatusText" Text="Stopped" VerticalAlignment="Center" Foreground="White"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="6">
            <TabItem Header="Bindings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14">
                            Select a controller above, then hit <Run FontWeight="Bold">Listen</Run> next to each 2XKO input and press
                            it on your controller. Directions set which D-Pad/stick source is used. Every other input captures
                            whatever physical button you press into <Run FontStyle="Italic">Bound to</Run> — separately, pick which
                            virtual Xbox 360 button it should fire in <Run FontStyle="Italic">Output</Run>. These are independent:
                            a DirectInput controller's physical buttons (e.g. "button5") aren't valid Xbox button names, so unlike an
                            XInput controller's own buttons, they can't just be passed straight through — pick the Output manually
                            for those. Edit further in the Profile Editor tab if needed.
                        </TextBlock>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Input" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Bound to" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Output" FontWeight="Bold"/>
                        </Grid>

                        <ItemsControl x:Name="BindingRowsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FF3A3A3A" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BoundText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=XInputButtonOptions}"
                                                      SelectedItem="{Binding OutputButton, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectionChanged="OutputButtonCombo_SelectionChanged" Tag="{Binding}" Margin="0,0,4,0">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirection}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <Button Grid.Column="3" Content="{Binding ListenButtonText}" Padding="8,2" HorizontalAlignment="Left" Click="ListenButton_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hide from Game (experimental)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Hide the real controller from 2XKO" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            HidHide can't cloak XInput controllers — it only filters the HID class stack, and XInput talks to the
                            device through a separate driver path HidHide never sees. The real fix is changing which Windows driver
                            owns the controller: if it's not bound to the Xbox-compatible class driver, XInput (and most modern games,
                            including UE-based titles) can't see it at all, while 236KO can still read it as a generic HID/DirectInput
                            device.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            This scans for candidate controllers and shows which driver each is currently bound to. Click
                            <Run FontWeight="Bold">Update driver…</Run> to open Windows' own device dialog, then: Update Driver →
                            Browse my computer for drivers → Let me pick from a list of available drivers → select
                            <Run FontWeight="Bold">HID-compliant game controller</Run>. This app does not change the driver binding
                            itself — that step is entirely Windows' own wizard, which also has a built-in
                            <Run FontStyle="Italic">Roll Back Driver</Run> button on the same screen if you want to undo it.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="Orange">
                            Experimental: this changes system-wide driver binding for the device, affecting every app until you roll
                            it back — not just 2XKO. Try it on a controller you don't mind troubleshooting first. The one-click
                            rebind buttons below require Administrator (a UAC prompt appears) and aren't guaranteed to succeed on
                            every controller/Windows version — fall back to "Update driver…" and picking manually if they fail.
                        </TextBlock>

                        <Button x:Name="ScanDriversButton" Content="Scan for controllers" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,10" Click="ScanDriversButton_Click"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Device" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Current driver" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold"/>
                        </Grid>

                        <ItemsControl x:Name="DriverCandidatesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FF3A3A3A" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DriverService}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="Update driver…" Padding="6,2" HorizontalAlignment="Left" Click="OpenDeviceProperties_Click" Tag="{Binding InstanceId}"/>
                                            <Button Grid.Column="4" Content="{Binding RebindButtonLabel}" Padding="6,2" HorizontalAlignment="Left" Click="RebindDriver_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="DriverScanEmptyText" Text="Click &quot;Scan for controllers&quot; to list candidates." Foreground="Gray" Margin="0,8,0,0"/>

                        <Separator Margin="0,20,0,16"/>

                        <TextBlock Text="Per-Process Cloak" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            Hides one controller from a single, already-running process only — every other process (including
                            other games, or this app itself) still sees it normally. Works by injecting a small helper into
                            the target process that reports the controller as disconnected to it specifically. Automatically
                            stops hiding the moment 236KO closes or crashes — no cleanup step needed.
                        </TextBlock>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Controller:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" x:Name="CloakControllerCombo" DisplayMemberPath="DisplayName" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" x:Name="RefreshCloakTargetsButton" Content="Refresh lists" Padding="8,2" Click="RefreshCloakTargetsButton_Click"/>
                        </Grid>

                        <TextBlock Text="Target process (must already be running):" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CloakProcessCombo" DisplayMemberPath="DisplayName" Margin="0,0,0,10" DropDownOpened="CloakProcessCombo_DropDownOpened"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="StartCloakButton" Content="Start Cloak" Padding="10,3" Click="StartCloakButton_Click"/>
                            <Button x:Name="StopCloakButton" Content="Stop Cloak" Padding="10,3" Margin="8,0,0,0" Click="StopCloakButton_Click" IsEnabled="False"/>
                            <Ellipse x:Name="CloakStatusDot" Width="12" Height="12" Fill="Gray" Margin="16,0,4,0"/>
                            <TextBlock x:Name="CloakStatusText" Text="Inactive" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Monitor">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="6">
                        <TextBlock Text="Direction" FontSize="14" FontWeight="Bold"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,6,0,10" Padding="16" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="DirectionText" Text="5" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DirectionArrowText" Text="neutral" FontSize="14" HorizontalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Held Inputs" FontWeight="Bold"/>
                        <TextBlock x:Name="HeldInputsText" Text="—" TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <TextBlock Text="Analog / Axis Values" FontWeight="Bold"/>
                        <TextBlock x:Name="AnalogValuesText" Text="—" TextWrapping="Wrap" Margin="0,4,0,12" FontFamily="Consolas" FontSize="11"/>

                        <TextBlock Text="Pending Motion / Attack Window" FontWeight="Bold"/>
                        <TextBlock x:Name="PendingMotionText" Text="—" Margin="0,4,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="Last Output" FontWeight="Bold"/>
                        <TextBlock x:Name="LastOutputText" Text="—" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <DockPanel Grid.Column="1" Margin="6">
                        <TextBlock DockPanel.Dock="Top" Text="Recognition Log" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListBox x:Name="MotionLogList" FontFamily="Consolas" FontSize="12"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Profile Editor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <TextBlock Text="Controller Input" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="UseDpadCheck" Content="D-Pad" Margin="0,0,16,0" Checked="DirectionSourceCheck_Changed" Unchecked="DirectionSourceCheck_Changed"/>
                            <CheckBox x:Name="UseLeftStickCheck" Content="Left Stick" Margin="0,0,16,0" Checked="DirectionSourceCheck_Changed" Unchecked="DirectionSourceCheck_Changed"/>
                            <CheckBox x:Name="UseRightStickCheck" Content="Right Stick" Margin="0,0,16,0" Checked="DirectionSourceCheck_Changed" Unchecked="DirectionSourceCheck_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Stick deadzone:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="StickDeadzoneBox" Width="60"/>
                            <TextBlock Text="Trigger threshold:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox x:Name="TriggerThresholdBox" Width="60"/>
                            <TextBlock Text="Poll rate (Hz):" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox x:Name="PollRateBox" Width="60"/>
                        </StackPanel>

                        <TextBlock Text="Buffer / Leniency" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Max sequence (ms):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="MaxSequenceMsBox" Width="60"/>
                            <TextBlock Text="Max gap (ms):" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox x:Name="MaxGapMsBox" Width="60"/>
                            <TextBlock Text="Attack window (ms):" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox x:Name="AttackWindowMsBox" Width="60"/>
                            <TextBlock Text="Motion cooldown (ms):" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox x:Name="MotionCooldownMsBox" Width="60"/>
                        </StackPanel>

                        <TextBlock Text="Motions (priority order — top matches first)" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <DataGrid x:Name="MotionsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Height="180" Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                                <DataGridTextColumn Header="Sequence (e.g. 2,3,6)" Binding="{Binding SequenceText}" Width="160"/>
                                <DataGridCheckBoxColumn Header="Diagonal skip" Binding="{Binding AllowDiagonalSkip}" Width="90"/>
                                <DataGridTextColumn Header="Max seq ms (blank=default)" Binding="{Binding MaxSequenceMsText}" Width="150"/>
                                <DataGridTextColumn Header="Max gap ms (blank=default)" Binding="{Binding MaxGapMsText}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Motion + Attack Outputs (fires when the attack lands inside the motion's attack window) — direction, then role" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <DataGrid x:Name="MotionOutputsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Height="200" Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Motion" Binding="{Binding Motion}" Width="120"/>
                                <DataGridTemplateColumn Header="Attack role" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RoleNameOptions}"
                                                      IsEditable="True" Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Direction" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DirectionOutputOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Token"
                                                      SelectedValue="{Binding Direction, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Output role" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RoleNameOptions}"
                                                      IsEditable="True" Text="{Binding OutputRole, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Output role 2 (optional)" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RoleNameOptions}"
                                                      IsEditable="True" Text="{Binding OutputRole2, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Attack Outputs (fires on a bare attack press, no motion)" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <DataGrid x:Name="AttackOutputsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Height="120" Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140"/>
                                <DataGridTextColumn Header="Output tokens (comma separated)" Binding="{Binding ValuesText}" Width="360"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
